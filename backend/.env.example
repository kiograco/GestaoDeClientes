# =============================================================================
# AMBIENTE
# =============================================================================
NODE_ENV=production                         # OBRIGATÓRIO — production | development
BACKEND_URL=https://api.example.com         # OBRIGATÓRIO — URL pública do backend (sem barra final)
FRONTEND_URL=https://crm.example.com        # OBRIGATÓRIO — URL pública do frontend (sem barra final)
PORT=3100                                   # OBRIGATÓRIO — porta HTTP do backend

# =============================================================================
# AUTENTICAÇÃO E ADMIN
# =============================================================================
JWT_SECRET=replace-with-a-long-random-secret          # OBRIGATÓRIO — mínimo 32 chars aleatórios: openssl rand -hex 32
JWT_REFRESH_SECRET=replace-with-another-long-random-secret  # OBRIGATÓRIO — mínimo 32 chars aleatórios: openssl rand -hex 32
SUPERADMIN_EMAIL=owner@example.com                    # OBRIGATÓRIO — email do superadmin inicial
SUPERADMIN_PASSWORD=replace-with-a-strong-superadmin-password  # OBRIGATÓRIO — mínimo 10 chars, maiúscula, minúscula, número e símbolo

# =============================================================================
# EMAIL (Resend)
# =============================================================================
RESEND_API_KEY=replace-with-resend-api-key            # OBRIGATÓRIO — chave da API Resend (resend.com)
RESEND_FROM_EMAIL=noreply@example.com                 # OBRIGATÓRIO — email remetente do domínio verificado no Resend
MAIL_FROM=NCProgrammers CRM <noreply@example.com>     # OPCIONAL  — nome exibido no "De:" dos emails
MAIL_REPLY_TO=atendimento@example.com                 # OPCIONAL  — endereço de resposta para emails transacionais

# =============================================================================
# BANCO DE DADOS (PostgreSQL)
# =============================================================================
POSTGRES_HOST=postgres                      # OBRIGATÓRIO — hostname ou IP do PostgreSQL
POSTGRES_DB=izing                           # OBRIGATÓRIO — nome do banco de dados
POSTGRES_USER=postgres                      # OBRIGATÓRIO — usuário do banco
POSTGRES_PASSWORD=replace-with-a-strong-password  # OBRIGATÓRIO — senha do PostgreSQL

# =============================================================================
# CACHE E FILAS (Redis)
# =============================================================================
IO_REDIS_SERVER=redis                       # OBRIGATÓRIO — hostname ou IP do Redis
IO_REDIS_PORT=6379                          # OBRIGATÓRIO — porta do Redis
IO_REDIS_USERNAME=                          # OPCIONAL  — usuário Redis (deixe vazio se não usa ACL)
IO_REDIS_PASSWORD=replace-with-a-strong-password  # OBRIGATÓRIO — senha do Redis

# Rate limiting: use "redis" para multi-instância. "memory" é apenas para dev single-node.
RATE_LIMIT_STORE=redis                      # OBRIGATÓRIO — redis | memory

# =============================================================================
# FILAS DE MENSAGENS (RabbitMQ)
# =============================================================================
RABBITMQ_DEFAULT_USER=replace-with-a-rabbitmq-user   # OBRIGATÓRIO — usuário do RabbitMQ
RABBITMQ_DEFAULT_PASS=replace-with-a-strong-password # OBRIGATÓRIO — senha do RabbitMQ

# =============================================================================
# INTEGRAÇÃO META — INSTAGRAM
# =============================================================================
INSTAGRAM_APP_ID=replace-with-meta-instagram-app-id             # OPCIONAL — ID do app Meta para Instagram DM
INSTAGRAM_APP_SECRET=replace-with-meta-instagram-app-secret     # OPCIONAL — secret do app Meta
INSTAGRAM_REDIRECT_URI=https://api.example.com/instagram/oauth/callback  # OPCIONAL — URI de callback OAuth
# Token aleatório curto (não uma URL). Gere com: openssl rand -hex 20
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=replace-with-random-hex-token    # OPCIONAL — token para verificação de webhook Meta
INSTAGRAM_GRAPH_URL=https://graph.instagram.com                 # OPCIONAL — URL da Graph API (não alterar)

# =============================================================================
# INTEGRAÇÃO 360DIALOG (WhatsApp Cloud API)
# =============================================================================
DIALOG360_WEBHOOK_SECRET=                   # OPCIONAL — segredo HMAC-SHA256 para validar webhooks 360Dialog

# =============================================================================
# INTEGRAÇÃO ASAAS (Pagamentos / Cobrança)
# =============================================================================
ASAAS_API_KEY=replace-with-asaas-api-key               # OPCIONAL — chave de API do Asaas
ASAAS_API_URL=https://api.asaas.com/v3                 # OPCIONAL — URL base da API Asaas
ASAAS_WEBHOOK_TOKEN=replace-with-a-random-asaas-webhook-token  # OPCIONAL — token para validar webhooks Asaas
ASAAS_RENEW_ON_CARD_CONFIRMED=false         # OPCIONAL — renovar acesso ao confirmar pagamento no cartão
ASAAS_SUSPEND_ON_REFUND=false               # OPCIONAL — suspender acesso ao registrar estorno
