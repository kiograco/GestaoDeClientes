NODE_ENV=production
BACKEND_URL=https://api.example.com
FRONTEND_URL=https://crm.example.com
PORT=3100

JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
SUPERADMIN_EMAIL=owner@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-superadmin-password

RESEND_API_KEY=replace-with-resend-api-key
MAIL_FROM=Ebenezer Saude Ambiental <os@ebenezersaudeambiental.com.br>
MAIL_REPLY_TO=atendimento@ebenezersaudeambiental.com.br

ASAAS_API_KEY=replace-with-asaas-api-key
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=replace-with-a-random-asaas-webhook-token
ASAAS_RENEW_ON_CARD_CONFIRMED=false
ASAAS_SUSPEND_ON_REFUND=false

POSTGRES_HOST=postgres
POSTGRES_DB=izing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password

IO_REDIS_SERVER=redis
IO_REDIS_PORT=6379
IO_REDIS_USERNAME=
IO_REDIS_PASSWORD=replace-with-a-strong-password

RABBITMQ_DEFAULT_USER=replace-with-a-rabbitmq-user
RABBITMQ_DEFAULT_PASS=replace-with-a-strong-password

INSTAGRAM_APP_ID=replace-with-meta-instagram-app-id
INSTAGRAM_APP_SECRET=replace-with-meta-instagram-app-secret
INSTAGRAM_REDIRECT_URI=https://api.example.com/instagram/oauth/callback
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-webhook-verify-token
INSTAGRAM_GRAPH_URL=https://graph.instagram.com
