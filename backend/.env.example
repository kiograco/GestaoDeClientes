# =============================================================================
# AMBIENTE
# =============================================================================
NODE_ENV=production                         # OBRIGATÓRIO — production | development
BACKEND_URL=https://api.example.com         # OBRIGATÓRIO — URL pública do backend (sem barra final)
FRONTEND_URL=https://crm.example.com        # OBRIGATÓRIO — URL pública do frontend (sem barra final). Aceita múltiplas origens separadas por vírgula (ex.: "https://crm.example.com,https://staging.example.com")
PORT=3100                                   # OBRIGATÓRIO — porta HTTP do backend
DB_DIALECT=postgres                         # OPCIONAL  — dialeto do Sequelize (não altere)
CONNECTIONS_LIMIT=                          # OPCIONAL  — limite de conexões de canal (WhatsApp/Instagram/etc.) por empresa; sem limite se vazio
USER_LIMIT=                                 # OPCIONAL  — limite de usuários por empresa; sem limite se vazio
PERSISTENT_DATA_DIR=                        # OPCIONAL  — diretório persistente para logos, sessões do WhatsApp e mídias (ex.: /app/data em produção)
PROXY_PORT=                                 # OPCIONAL  — porta pública usada ao montar links de download/campanha atrás de proxy reverso
SENTRY_DSN=                                 # OPCIONAL  — DSN do Sentry para captura de erros

# =============================================================================
# AUTENTICAÇÃO E ADMIN
# =============================================================================
JWT_SECRET=replace-with-a-long-random-secret          # OBRIGATÓRIO — mínimo 32 chars aleatórios: openssl rand -hex 32
JWT_REFRESH_SECRET=replace-with-another-long-random-secret  # OBRIGATÓRIO — mínimo 32 chars aleatórios: openssl rand -hex 32
SUPERADMIN_EMAIL=owner@example.com                    # OBRIGATÓRIO — email do superadmin inicial
SUPERADMIN_PASSWORD=replace-with-a-strong-superadmin-password  # OBRIGATÓRIO — mínimo 10 chars, maiúscula, minúscula, número e símbolo

# Painel de filas (/admin/queues). Sem estas duas variáveis, o painel fica desabilitado (404).
BULL_BOARD_USER=                            # OPCIONAL — usuário HTTP Basic Auth para acessar o painel Bull Board
BULL_BOARD_PASSWORD=                        # OPCIONAL — senha HTTP Basic Auth para acessar o painel Bull Board

# Documentação da API (/api-docs). Em desenvolvimento fica aberta; em produção exige estas credenciais.
API_DOCS_USER=                              # OPCIONAL — usuário HTTP Basic Auth para /api-docs em produção
API_DOCS_PASSWORD=                          # OPCIONAL — senha HTTP Basic Auth para /api-docs em produção

# =============================================================================
# EMAIL (Resend)
# =============================================================================
RESEND_API_KEY=replace-with-resend-api-key            # OBRIGATÓRIO — chave da API Resend (resend.com)
RESEND_FROM_EMAIL=noreply@example.com                 # OBRIGATÓRIO — email remetente do domínio verificado no Resend
MAIL_FROM=NCProgrammers CRM <noreply@example.com>     # OPCIONAL  — nome exibido no "De:" dos emails
MAIL_REPLY_TO=atendimento@example.com                 # OPCIONAL  — endereço de resposta para emails transacionais

# =============================================================================
# BANCO DE DADOS (PostgreSQL)
# =============================================================================
POSTGRES_HOST=postgres                      # OBRIGATÓRIO — hostname ou IP do PostgreSQL
POSTGRES_DB=izing                           # OBRIGATÓRIO — nome do banco de dados
POSTGRES_USER=postgres                      # OBRIGATÓRIO — usuário do banco
POSTGRES_PASSWORD=replace-with-a-strong-password  # OBRIGATÓRIO — senha do PostgreSQL

# =============================================================================
# CACHE E FILAS (Redis)
# =============================================================================
IO_REDIS_SERVER=redis                       # OBRIGATÓRIO — hostname ou IP do Redis
IO_REDIS_PORT=6379                          # OBRIGATÓRIO — porta do Redis
IO_REDIS_USERNAME=                          # OPCIONAL  — usuário Redis (deixe vazio se não usa ACL)
IO_REDIS_PASSWORD=replace-with-a-strong-password  # OBRIGATÓRIO — senha do Redis
IO_REDIS_DB_SESSION=9                       # OPCIONAL  — número do database Redis usado para sessões/cache (padrão 9)

# Rate limiting: use "redis" para multi-instância. "memory" é apenas para dev single-node.
RATE_LIMIT_STORE=redis                      # OBRIGATÓRIO — redis | memory

# =============================================================================
# FILAS DE MENSAGENS (RabbitMQ)
# =============================================================================
RABBITMQ_DEFAULT_USER=replace-with-a-rabbitmq-user   # OBRIGATÓRIO — usuário do RabbitMQ
RABBITMQ_DEFAULT_PASS=replace-with-a-strong-password # OBRIGATÓRIO — senha do RabbitMQ
AMQP_URL=                                   # OPCIONAL  — string de conexão amqp://user:pass@host:5672 usada pelos consumidores de fila do Messenger e 360Dialog

# =============================================================================
# COMPORTAMENTO WHATSAPP (Baileys / Puppeteer)
# =============================================================================
CHROME_BIN=                                 # OPCIONAL  — caminho do binário Chrome/Chromium usado pelo Puppeteer
CHROME_ARGS=                                # OPCIONAL  — flags extras do Chrome separadas por vírgula (ex.: --no-sandbox,--disable-gpu)
PATH_OFFLINE_MEDIA=                         # OPCIONAL  — diretório alternativo para mídias enviadas offline
WAPP_ANTISPAM_ENABLED=true                  # OPCIONAL  — true|false — habilita o guard antispam de envio do WhatsApp (padrão true)
MIN_SLEEP_INTERVAL=500                      # OPCIONAL  — intervalo mínimo (ms) entre reprocessamentos/envios
MAX_SLEEP_INTERVAL=2000                     # OPCIONAL  — intervalo máximo (ms) entre reprocessamentos/envios
CHECK_INTERVAL=5000                         # OPCIONAL  — intervalo (ms) de verificação dos bots do Messenger/360Dialog

# =============================================================================
# INTEGRAÇÃO META — INSTAGRAM
# =============================================================================
INSTAGRAM_APP_ID=replace-with-meta-instagram-app-id             # OPCIONAL — ID do app Meta para Instagram DM
INSTAGRAM_APP_SECRET=replace-with-meta-instagram-app-secret     # OPCIONAL — secret do app Meta
INSTAGRAM_REDIRECT_URI=https://api.example.com/instagram/oauth/callback  # OPCIONAL — URI de callback OAuth
# Token aleatório curto (não uma URL). Gere com: openssl rand -hex 20
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=replace-with-random-hex-token    # OPCIONAL — token para verificação de webhook Meta
INSTAGRAM_GRAPH_URL=https://graph.instagram.com                 # OPCIONAL — URL da Graph API (não alterar)

# =============================================================================
# INTEGRAÇÃO META — WHATSAPP CLOUD API (API Oficial)
# =============================================================================
META_APP_ID=replace-with-meta-app-id                         # OBRIGATÓRIO — ID do app Meta usado no OAuth do WhatsApp (fallback: VUE_FACEBOOK_APP_ID)
META_APP_SECRET=replace-with-meta-app-secret                 # OBRIGATÓRIO — secret do app Meta; também usado para validar a assinatura do webhook (fallback: FACEBOOK_APP_SECRET)
META_WHATSAPP_REDIRECT_URI=https://api.example.com/api/v1/whatsapp/meta/callback  # OBRIGATÓRIO — URI de callback do OAuth (deve bater com o configurado no app Meta)
META_GRAPH_API_VERSION=v20.0                                 # OPCIONAL — versão da Graph API usada em todas as chamadas (padrão v20.0)
META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=                     # OPCIONAL — config_id do Embedded Signup, se configurado no app Meta
# Variáveis legadas — mantidas apenas como fallback quando META_APP_ID/META_APP_SECRET não estão definidas.
# Preferir sempre META_APP_ID/META_APP_SECRET em instalações novas.
VUE_FACEBOOK_APP_ID=                        # OPCIONAL — fallback legado de META_APP_ID (integração Facebook/Messenger)
FACEBOOK_APP_SECRET=                        # OPCIONAL — fallback legado de META_APP_SECRET na validação do webhook Meta
FACEBOOK_APP_SECRET_KEY=                    # OPCIONAL — fallback legado de META_APP_SECRET no fluxo OAuth do Facebook/Messenger

# =============================================================================
# INTEGRAÇÃO 360DIALOG (WhatsApp Cloud API)
# =============================================================================
API_URL_360=https://waba-v2.360dialog.io    # OPCIONAL — URL base da API 360Dialog
DIALOG360_WEBHOOK_SECRET=                   # OPCIONAL — segredo HMAC-SHA256 para validar webhooks 360Dialog

# =============================================================================
# INTEGRAÇÃO ASAAS (Pagamentos / Cobrança)
# =============================================================================
ASAAS_API_KEY=replace-with-asaas-api-key               # OPCIONAL — chave de API do Asaas
ASAAS_API_URL=https://api.asaas.com/v3                 # OPCIONAL — URL base da API Asaas
ASAAS_WEBHOOK_TOKEN=replace-with-a-random-asaas-webhook-token  # OBRIGATÓRIO se Asaas habilitado — token estático enviado no header asaas-access-token
ASAAS_WEBHOOK_SECRET=replace-with-a-random-asaas-webhook-secret  # OBRIGATÓRIO se Asaas habilitado — segredo HMAC-SHA256 usado para validar a assinatura do webhook (header asaas-signature); sem ele, todo webhook do Asaas falha com 500
ASAAS_RENEW_ON_CARD_CONFIRMED=false         # OPCIONAL — renovar acesso ao confirmar pagamento no cartão
ASAAS_SUSPEND_ON_REFUND=false               # OPCIONAL — suspender acesso ao registrar estorno
