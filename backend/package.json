{
  "name": "backend",
  "version": "2.0.0",
  "description": "NCProgrammers CRM - sistema de atendimentos multicanal",
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-email-templates.js",
    "lint": "eslint --ext .ts src --max-warnings 0",
    "lint:fix": "eslint --ext .ts src --fix",
    "watch": "tsc -w",
    "start": "nodemon --inspect  dist/server.js",
    "dev:server": "ts-node-dev --inspect=9229 --respawn --transpile-only --ignore node_modules src/server.ts",
    "test": "cross-env NODE_ENV=test POSTGRES_HOST=localhost POSTGRES_DB=wchats_test POSTGRES_USER=postgres POSTGRES_PASSWORD=postgres DB_PORT=5432 jest --runInBand",
    "test:unit": "cross-env NODE_ENV=test POSTGRES_HOST=localhost POSTGRES_DB=wchats_test POSTGRES_USER=postgres POSTGRES_PASSWORD=postgres DB_PORT=5432 jest --selectProjects unit --runInBand",
    "test:integration": "cross-env NODE_ENV=test POSTGRES_HOST=localhost POSTGRES_DB=wchats_test POSTGRES_USER=postgres POSTGRES_PASSWORD=postgres DB_PORT=5432 jest --selectProjects integration --runInBand",
    "test:coverage": "cross-env NODE_ENV=test POSTGRES_HOST=localhost POSTGRES_DB=wchats_test POSTGRES_USER=postgres POSTGRES_PASSWORD=postgres DB_PORT=5432 jest --coverage --runInBand",
    "test:db:create": "cross-env NODE_ENV=test POSTGRES_HOST=localhost POSTGRES_DB=wchats_test POSTGRES_USER=postgres POSTGRES_PASSWORD=postgres DB_PORT=5432 node scripts/create-test-database.js",
    "test:migrate": "npm run build && cross-env NODE_ENV=test POSTGRES_HOST=localhost POSTGRES_DB=wchats_test POSTGRES_USER=postgres POSTGRES_PASSWORD=postgres DB_PORT=5432 sequelize db:migrate",
    "test:seed": "cross-env NODE_ENV=test POSTGRES_HOST=localhost POSTGRES_DB=wchats_test POSTGRES_USER=postgres POSTGRES_PASSWORD=postgres DB_PORT=5432 sequelize db:seed:all",
    "test:db:prepare": "npm run test:db:create && npm run test:migrate",
    "test:db:reset": "cross-env NODE_ENV=test POSTGRES_HOST=localhost POSTGRES_DB=wchats_test POSTGRES_USER=postgres POSTGRES_PASSWORD=postgres DB_PORT=5432 sequelize db:migrate:undo:all && npm run test:migrate && npm run test:seed",
    "privacy:retention": "node scripts/run-privacy-retention.js",
    "db:migrate": "rm -Rf dist && npm run build && npx sequelize db:migrate",
    "db:seed": "npx sequelize db:seed:all",
    "db:seed:demo": "npx sequelize db:seed --seed 20260608130000-create-demo-service-order-account.js"
  },
  "author": "Durans (lumardyelson@gmail.com)",
  "private": true,
  "license": "AGPL-3.0-or-later",
